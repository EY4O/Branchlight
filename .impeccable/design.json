  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Quiet paper button for every ordinary command.",
      "html": "<button class=\"ds-button\"><svg class=\"ds-icon\" viewBox=\"0 0 20 20\"><path d=\"M2.75 5.5v9.75c0 .55.45 1 1 1h12.5c.55 0 1-.45 1-1V7.75c0-.55-.45-1-1-1H9.9L8.2 4.5H3.75c-.55 0-1 .45-1 1z\"/></svg>Open</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 12px;border:1px solid var(--rule-strong,#b3bdb0);border-radius:5px;background:var(--sheet,#fbfcf9);color:var(--ink,#17251e);font:500 13.5px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-button:hover{background:var(--sheet-2,#f1f3ee);border-color:var(--ink-3,#576559)}.ds-button:active{background:var(--sheet-3,#e8ece5)}.ds-button:focus-visible{outline:2px solid var(--action,#2b7549);outline-offset:2px}.ds-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Action Button",
      "kind": "button",
      "refersTo": "button-action",
      "description": "The one Action Green button per context, e.g. Simulate route.",
      "html": "<button class=\"ds-button-action\"><svg class=\"ds-icon\" viewBox=\"0 0 20 20\"><path d=\"M6.5 4.75v10.5L15 10z\" fill=\"currentColor\"/></svg>Simulate route</button>",
      "css": ".ds-button-action{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 12px;border:1px solid var(--action,#2b7549);border-radius:5px;background:var(--action,#2b7549);color:var(--action-ink,#fff);font:600 13.5px/1 -apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-button-action:hover{background:var(--action-hover,#22623c);border-color:var(--action-hover,#22623c)}.ds-button-action:focus-visible{outline:2px solid var(--action,#2b7549);outline-offset:2px}.ds-icon{width:18px;height:18px;flex:none}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Monospace search with sans placeholder; Action Green focus outline.",
      "html": "<label class=\"ds-search\"><svg class=\"ds-icon\" viewBox=\"0 0 20 20\"><circle cx=\"8.75\" cy=\"8.75\" r=\"5\"/><path d=\"M12.5 12.5l4 4\"/></svg><input placeholder=\"Find a variable\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:6px;height:32px;padding:0 9px;border:1px solid var(--rule-strong,#b3bdb0);border-radius:4px;background:var(--sheet,#fbfcf9);color:var(--ink-3,#576559)}.ds-search:focus-within{border-color:var(--ink-3,#576559);outline:2px solid var(--action,#2b7549);outline-offset:1px}.ds-search input{width:190px;border:0;background:none;outline:none;font:13px ui-monospace,'SF Mono',Menlo,monospace;color:var(--ink,#17251e)}.ds-search input::placeholder{font-family:-apple-system,system-ui,sans-serif;color:var(--ink-3,#576559)}.ds-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round}"
    },
    {
      "name": "View Tabs",
      "kind": "nav",
      "refersTo": "",
      "description": "Top-bar view tabs with monospace counts and an ink underline on the current view.",
      "html": "<nav class=\"ds-tabs\"><a aria-current=\"page\">Overview</a><a>Map</a><a>Variables <span class=\"ds-count\">5</span></a><a>Problems <span class=\"ds-count ds-alert\">4</span></a></nav>",
      "css": ".ds-tabs{display:flex;gap:2px;height:56px;border-bottom:1px solid var(--rule,#d3d9cf);background:var(--ground,#e6e9e2);font-family:-apple-system,system-ui,sans-serif}.ds-tabs a{position:relative;display:flex;align-items:center;gap:7px;padding:0 11px;font-size:14px;font-weight:500;color:var(--ink-3,#576559);cursor:pointer;transition:color .15s}.ds-tabs a:hover,.ds-tabs a[aria-current=page]{color:var(--ink,#17251e)}.ds-tabs a[aria-current=page]::after{content:'';position:absolute;left:11px;right:11px;bottom:-1px;height:2px;border-radius:1px;background:var(--ink,#17251e)}.ds-count{min-width:20px;padding:0 5px;border-radius:3px;background:var(--sheet-3,#e8ece5);font:500 11.5px/18px ui-monospace,Menlo,monospace;color:var(--ink-2,#46554c);text-align:center}.ds-count.ds-alert{background:var(--stamp-wash,#f8e8e1);color:var(--stamp,#a33f27)}"
    },
    {
      "name": "Genus Folder",
      "kind": "card",
      "refersTo": "folder",
      "description": "A file card with its folder-colour tab sized by share of scenes.",
      "html": "<button class=\"ds-folder\" style=\"--f:#6a8d58;--share:.6\"><span class=\"ds-fname\">script.rpy</span><span class=\"ds-fprob\">1</span><span class=\"ds-fmeta\">3 labels · 6 choices · 41 lines</span></button>",
      "css": ".ds-folder{position:relative;display:grid;grid-template-columns:1fr auto;gap:3px 8px;width:236px;margin-top:8px;padding:10px 11px 11px;border:1px solid var(--rule-strong,#b3bdb0);border-radius:0 4px 4px 4px;background:var(--sheet,#fbfcf9);text-align:left;cursor:pointer;font-family:-apple-system,system-ui,sans-serif;transition:border-color .15s,box-shadow .15s}.ds-folder::before{content:'';position:absolute;left:-1px;top:-8px;width:calc(20% + var(--share,1)*60%);height:8px;border-radius:4px 6px 0 0;background:var(--f)}.ds-folder:hover{border-color:var(--f)}.ds-folder:focus-visible{outline:2px solid var(--action,#2b7549);outline-offset:2px}.ds-fname{font:500 13px/1.35 ui-monospace,Menlo,monospace;color:var(--ink,#17251e)}.ds-fprob{font:500 11.5px/18px ui-monospace,Menlo,monospace;padding:0 5px;border-radius:3px;background:var(--stamp-wash,#f8e8e1);color:var(--stamp,#a33f27)}.ds-fmeta{grid-column:1/-1;font-size:12px;color:var(--ink-3,#576559)}"
    },
    {
      "name": "Specimen Label",
      "kind": "custom",
      "refersTo": "specimen-label",
      "description": "Typed collection label: hairline frame, sans title, monospace values.",
      "html": "<dl class=\"ds-label\"><div class=\"ds-label-title\">The lantern path</div><dt>Files</dt><dd>3</dd><dt>Labels</dt><dd>11</dd><dt>Problems</dt><dd>4</dd></dl>",
      "css": ".ds-label{display:grid;grid-template-columns:auto 1fr;gap:3px 14px;width:240px;margin:0;padding:11px 13px 12px;border:1px solid var(--ink-3,#576559);border-radius:2px;background:var(--sheet,#fbfcf9);font:12px/1.55 -apple-system,system-ui,sans-serif}.ds-label-title{grid-column:1/-1;margin-bottom:5px;padding-bottom:6px;border-bottom:1px solid var(--rule-strong,#b3bdb0);font-weight:600;font-size:13px;color:var(--ink,#17251e)}.ds-label dt{color:var(--ink-3,#576559)}.ds-label dd{margin:0;font-family:ui-monospace,Menlo,monospace;text-align:right;font-variant-numeric:tabular-nums;color:var(--ink,#17251e)}"
    },
    {
      "name": "Determination Slip",
      "kind": "card",
      "refersTo": "determination-slip",
      "description": "A problem record with a framed severity stamp and a file:line reference.",
      "html": "<div class=\"ds-slip\"><span class=\"ds-stamp\">Missing label</span><p>Label “ridge” is not in the loaded files.</p><div class=\"ds-ref\"><i class=\"ds-ftab\"></i>endings.rpy:10 <a>Show on map</a></div></div>",
      "css": ".ds-slip{display:grid;gap:5px;width:300px;padding:10px 12px 11px;border:1px solid var(--rule,#d3d9cf);border-radius:3px;background:var(--sheet,#fbfcf9);box-shadow:0 1px 1px rgb(23 37 30/.05),0 2px 5px -1px rgb(23 37 30/.10);font-family:-apple-system,system-ui,sans-serif}.ds-stamp{justify-self:start;padding:0 5px;border:1px solid currentColor;border-radius:2px;font-size:10.5px;font-weight:650;letter-spacing:.06em;text-transform:uppercase;line-height:17px;color:var(--stamp,#a33f27)}.ds-slip p{margin:0;font-size:13px;line-height:1.5;color:var(--ink,#17251e)}.ds-ref{display:flex;align-items:center;gap:8px;font:11.5px/1.5 ui-monospace,Menlo,monospace;color:var(--ink-3,#576559)}.ds-ref a{margin-left:auto;font:12px -apple-system,system-ui,sans-serif;color:var(--ink-2,#46554c);cursor:pointer}.ds-ref a:hover{color:var(--ink,#17251e);text-decoration:underline}.ds-ftab{display:inline-block;width:13px;height:6px;border-radius:2px 3px 0 0;background:#4c7596}"
    },
    {
      "name": "Barcode Strip",
      "kind": "custom",
      "refersTo": "",
      "description": "Per-variable strip: ink ticks above where it is changed, amber below where it is checked, on per-file baselines.",
      "html": "<svg class=\"ds-barcode\" viewBox=\"0 0 300 22\" preserveAspectRatio=\"none\"><line class=\"ds-base\" x1=\"0\" y1=\"11\" x2=\"118\" y2=\"11\" stroke=\"#6a8d58\"/><line class=\"ds-base\" x1=\"122\" y1=\"11\" x2=\"198\" y2=\"11\" stroke=\"#ad8a37\"/><line class=\"ds-base\" x1=\"202\" y1=\"11\" x2=\"300\" y2=\"11\" stroke=\"#4c7596\"/><line class=\"ds-set\" x1=\"40\" y1=\"4\" x2=\"40\" y2=\"11\"/><line class=\"ds-set\" x1=\"150\" y1=\"4\" x2=\"150\" y2=\"11\"/><line class=\"ds-check\" x1=\"95\" y1=\"11\" x2=\"95\" y2=\"18\"/><line class=\"ds-check\" x1=\"240\" y1=\"11\" x2=\"240\" y2=\"18\"/></svg>",
      "css": ".ds-barcode{display:block;width:300px;height:22px}.ds-base{stroke-width:2;opacity:.45;vector-effect:non-scaling-stroke}.ds-set{stroke:var(--ink,#17251e);stroke-width:1.5;vector-effect:non-scaling-stroke}.ds-check{stroke:var(--amber-line,#b8892a);stroke-width:1.5;vector-effect:non-scaling-stroke}"
    },
    {
      "name": "Simulator Choice",
      "kind": "button",
      "refersTo": "choice-button",
      "description": "Next-decision choice in the route simulator, framed in Action Green.",
      "html": "<button class=\"ds-choice\">Call out to the owl<small>if courage &gt;= 1</small></button>",
      "css": ".ds-choice{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;width:320px;padding:10px 12px;border:1px solid var(--action,#2b7549);border-radius:4px;background:var(--sheet,#fbfcf9);color:var(--ink,#17251e);text-align:left;font:500 14px/1.45 -apple-system,system-ui,sans-serif;cursor:pointer}.ds-choice::before{content:'';grid-row:span 2;width:7px;height:7px;margin-top:7px;border-radius:50%;background:var(--action,#2b7549)}.ds-choice:hover{background:var(--action-wash,#e1efe4)}.ds-choice:focus-visible{outline:2px solid var(--action,#2b7549);outline-offset:2px}.ds-choice small{grid-column:2;font:400 11.5px/1.5 ui-monospace,Menlo,monospace;color:var(--ink-3,#576559)}"
    }
  ],
  "narrative": {
    "northStar": "The Herbarium Sheet",
    "overview": "The story is a pressed specimen: the whole branching plant mounted flat on one sheet, labelled and filed so a large collection reads at a glance. Every view sits on bright rag paper laid over a grey-green cabinet ground. Each script file is a genus folder with its own muted colour, carried as a folder tab on every node, row, and reference that belongs to it. Metadata is typed onto hairline-framed specimen labels in monospace; problems arrive as determination slips with a stamped category.\n\nThe surface is dense and quiet. Colour is almost entirely structural (folder hues, a deep specimen green for choice points) until something needs attention: stamp red for what is broken, amber for conditions and gates, violet for calls, and one saturated action green that means \"do this\" or \"this is the route you followed\". Depth is paper on paper, never glass or glow.\n\nDark mode is the cabinet at night: a deep green-black ground, sheets one step lighter, the same folder hues lifted for legibility. Motion has one signature, the camera glide that eases the map to an exact node when you drill in, and otherwise stays to short state transitions.",
    "keyCharacteristics": [
      "Rag-white sheets on a grey-green ground; ink is near-black green, never pure black.",
      "Six genus folder colours, one per file, shown as folder tabs.",
      "Monospace for every piece of script data: label names, file:line references, variable names, values, counts.",
      "One saturated green reserved for actions and the live simulated route.",
      "Hairline borders and paper-thin two-layer shadows; no gradients, no blur.",
      "An eased camera glide is the signature interaction."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Action Green appears only on things the user can act on and on the route they are simulating. Structure that is green for identity uses Specimen Green, which is darker and never interactive by colour alone.",
        "section": "colors"
      },
      {
        "name": "The One Meaning Rule",
        "body": "Stamp red is a problem, amber is a condition or gate, violet is a call. None of them is decoration, and none substitutes for another.",
        "section": "colors"
      },
      {
        "name": "The Folder Tab Rule",
        "body": "A file's colour travels with its content as a small tab (13 x 6px, top corners rounded), never as a fill behind text.",
        "section": "colors"
      },
      {
        "name": "The Typed Data Rule",
        "body": "If it was read from the script (a name, a value, a path, a line number, a count), it is set in monospace with tabular numerals. Explanations about it are set in sans.",
        "section": "typography"
      },
      {
        "name": "The Stamp Only Rule",
        "body": "Uppercase letter-spaced type exists only inside the framed stamp on a determination slip. It is not a heading device.",
        "section": "typography"
      },
      {
        "name": "The Mounted Paper Rule",
        "body": "A surface is either on the ground or a sheet with Lift. Only things floating over other content get High Lift. Compact slip lists inside a drawer drop the shadow entirely.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every script-derived value in monospace with tabular numerals.",
      "**Do** carry a file's identity as a folder tab in its folder colour wherever its content appears.",
      "**Do** reserve Action Green for actions, focus, and the simulated route; use Specimen Green for structural green.",
      "**Do** recede off-route or unreached content by colour and dashed outlines, keeping text readable.",
      "**Do** keep depth to Lift and High Lift on rag sheets over the cabinet ground.",
      "**Do** make the camera glide instant under `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** use stamp red, amber, or violet for anything other than problems, conditions and gates, and calls respectively.",
      "**Don't** add uppercase letter-spaced kickers or eyebrows over headings; uppercase lives only in slip stamps.",
      "**Don't** fill text areas with folder colours or use them for status.",
      "**Don't** add decorative gradients, blur, glow, or a dot-grid canvas; the ground is flat cabinet colour.",
      "**Don't** use pure black or pure white for ink or ground; both modes stay green-tinted."
    ]
  }
}